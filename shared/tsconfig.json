{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "strict": false,
        "esModuleInterop": true,
        "rootDir": "src",
        "outDir": "dist",
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"],
}
